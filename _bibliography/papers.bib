@article{llmattacks,
  abbr={arxiv },
  bibtex_show={False},
  title={Detecting Language Model Attacks with Perplexity},
  author={Michael Kamfonas, Gabriel Alon},
  year={2023},
  publisher={arxiv},
  citation_count={500+ Citations},
  scholar={https://scholar.google.com/citations?user=jmQMOTsAAAAJ&hl=en&oi=ao},
  abstract={Adversarial suffixes can jailbreak large language models and elicit dangerous responses. We evaluate these attacks using query perplexity from the open-source GPT-2 model and find that adversarial suffixes produce unusually high values. Plain perplexity filtering, however, creates substantial false positives across ordinary prompts. Combining perplexity with token length in a LightGBM classifier reduces those false positives and detects most adversarial attacks in the test set.},
  url={https://arxiv.org/abs/2308.14132},
  html = {https://arxiv.org/abs/2308.14132}
}

@article{transformerspaper,
  abbr={arxiv},
  bibtex_show={False},
  title={What Can Secondary Predictions Tell Us? An Exploration on Question-Answering with SQuAD-v2.0},
  author={Gabriel Alon,Michael Kamfonas},
  year={2022},
  publisher={arxiv},
  abstract={Question-answering models are usually evaluated only by their highest-confidence prediction. This work also examines lower-ranked predictions through Golden Rank, the position of the most confident prediction that exactly matches a ground-truth answer. Across 16 transformer models, correct answers in the secondary prediction space usually remain near the top. The paper uses Golden Rank to characterize question difficulty and introduces the Golden Rank Interpolated Median (GRIM), an aggregate measure of how closely failed predictions approach the model's top choice. Experiments on SQuAD 2.0 explore these metrics for error analysis, model comparison, and future adversarial-training research.},
  url={https://arxiv.org/abs/2206.14348},
  html = {https://arxiv.org/abs/2206.14348}
}
